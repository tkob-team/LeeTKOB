# Copy to deploy/.env on the VM (chmod 600) and fill in the values. Never commit deploy/.env.
# Names only; see README.md, "Deployment runbook".

# PostgreSQL account, used by postgres, api, judge-worker, checker-worker and seed.
DB_USER=
DB_PASSWORD=

# HS256 signing key of the API, at least 32 bytes (for example: openssl rand -base64 48).
JWT_SECRET=

# Host Docker socket and group ID. Mounted only by sandbox-proxy.
JUDGE_DOCKER_SOCKET=
DOCKER_GID=

# Use WEB_BIND=127.0.0.1 for the local stack.
WEB_BIND=
WEB_PORT=
OPERATIONS_PORT=

# Optional; default leetkob-sandbox:pa3, built on the host daemon.
JUDGE_SANDBOX_IMAGE=

# checker-worker only.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
GEMINI_RPM=
MODEL_OFF=

# seed only. Prefer exporting them in the shell for the one seed run instead of storing them here.
SEED_ADMIN_PASSWORD=
SEED_TA_PASSWORD=
SEED_STUDENT_PASSWORD=
