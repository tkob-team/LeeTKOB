# Copy to deploy/.env on the VM (chmod 600) and fill in the values. Never commit deploy/.env.
# Names only; see README.md, "Deployment runbook".

# caddy: public site address, for example tkob-leetkob.duckdns.org (HTTPS with a Let's Encrypt
# certificate, HTTP redirected). Use http://<domain> to serve plain HTTP only (rollback).
LEETKOB_DOMAIN=
# Optional contact address for the ACME account (certificate expiry notices).
ACME_EMAIL=

# PostgreSQL account, used by postgres, api, judge-worker, checker-worker and seed.
DB_USER=
DB_PASSWORD=

# HS256 signing key of the API, at least 32 bytes (for example: openssl rand -base64 48).
JWT_SECRET=

# Group id of /var/run/docker.sock on the VM: stat -c %g /var/run/docker.sock
DOCKER_GID=

# Optional; default leetkob-sandbox:pa3, built by `--profile build build`.
JUDGE_SANDBOX_IMAGE=

# checker-worker only.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
GEMINI_RPM=
MODEL_OFF=

# seed only. Prefer exporting them in the shell for the one seed run instead of storing them here.
SEED_ADMIN_PASSWORD=
SEED_TA_PASSWORD=
SEED_STUDENT_PASSWORD=
